  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3000"
    },
    {
      "key": "testPassword",
      "value": "TestPassword123!"
    },
    {
      "key": "clientEmail",
      "value": ""
    },
    {
      "key": "freelancerEmail",
      "value": ""
    },
    {
      "key": "missingFieldEmail",
      "value": ""
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "freelancerToken",
      "value": ""
    },
    {
      "key": "hustleId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
