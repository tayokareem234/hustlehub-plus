  ],
  "item": [
    {
      "name": "01 - Security and Public Marketplace",
      "item": [
        {
          "name": "Health endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint returns success', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Security headers are present', function () { pm.expect(pm.response.headers.has('X-Content-Type-Options')).to.be.true; pm.expect(pm.response.headers.has('Content-Security-Policy')).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "List marketplace services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hustles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Marketplace responds successfully', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Response contains success and hustles', function () { const b=pm.response.json(); pm.expect(b.success).to.equal(true); pm.expect(b.hustles).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Register client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Test Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"client\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clientEmail', 'newman.client.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client registration succeeds', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test('Registration returns success', function () { pm.expect(pm.response.json().success).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client login succeeds', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Client JWT and role are stored', function () { const b=pm.response.json(); pm.expect(b.token).to.be.a('string').and.not.empty; pm.expect(b.user.role).to.equal('client'); pm.collectionVariables.set('clientToken',b.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Test Freelancer\",\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('freelancerEmail', 'newman.freelancer.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Freelancer registration succeeds', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test('Registration returns success', function () { pm.expect(pm.response.json().success).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Freelancer login succeeds', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Freelancer JWT and role are stored', function () { const b=pm.response.json(); pm.expect(b.token).to.be.a('string').and.not.empty; pm.expect(b.user.role).to.equal('freelancer'); pm.collectionVariables.set('freelancerToken',b.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.invalid@example.com\",\n  \"password\": \"WrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid login is rejected', function () { pm.expect(pm.response.code).to.be.oneOf([400,401,422]); });",
                  "pm.test('Invalid login does not return a token', function () { const b=pm.response.json(); pm.expect(b.token).to.be.undefined; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Role-Based Access Control",
      "item": [
        {
          "name": "Freelancer creates a service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/hustles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Newman Automated Test Service\",\n  \"description\": \"Service created by the automated API test suite.\",\n  \"category\": \"Development\",\n  \"price\": 150,\n  \"location\": \"Pretoria\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Freelancer can create a service', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test('Created service ID is stored', function () { const b=pm.response.json(); const h=b.hustle || b.data || b; const id=h._id || h.id; pm.expect(id).to.exist; pm.collectionVariables.set('hustleId',id); });"
                ]
              }
            }
          ]
        },
